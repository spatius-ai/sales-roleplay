# Required: from app.spatius.ai
SPATIUS_API_KEY=
SPATIUS_APP_ID=
# us-west (default) or your region
SPATIUS_REGION=us-west

# Optional: your own OpenAI key. Without it, the buyer uses 30 free Spatius starter minutes.
OPENAI_API_KEY=

# Optional: ElevenLabs voices (each person has their own voice, with a native voice for Arabic).
# Without it, the OpenAI voice is used. Your key needs text-to-speech access.
ELEVENLABS_API_KEY=

# Optional: where the page starts (the rep can still change everything)
# Buyer: finance, it, owner    Difficulty: easy, realistic, tough    Language: en, es, zh, ar, fr
ROLEPLAY_BUYER=owner
ROLEPLAY_DIFFICULTY=realistic
ROLEPLAY_LANG=en
# Your own product, instead of the sample. Write \n for a new line.
# ROLEPLAY_PRODUCT=Acme CRM: a simple CRM for dental clinics. $49 per user per month.
# PORT=3000
